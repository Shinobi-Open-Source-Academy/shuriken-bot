# Shuriken configuration. Copy to .env for local development.
#
# Nothing in here is read from a file at runtime in production: the deployment
# supplies these as environment variables. The full table is in
# docs/configuration.md.

# ---- HTTP ----
SHURIKEN_ADDR=:8080
SHURIKEN_LOG_LEVEL=debug

# ---- GitHub App (required unless SHURIKEN_DRY_RUN=1) ----
# From the App's settings page.
SHURIKEN_GITHUB_APP_ID=
# The webhook secret you set when creating the App. Required ALWAYS, including
# in dry-run mode: without it nothing can be authenticated.
SHURIKEN_GITHUB_WEBHOOK_SECRET=
# Point at the downloaded .pem. Use SHURIKEN_GITHUB_PRIVATE_KEY for the inline
# PEM instead if your platform injects it as a variable.
SHURIKEN_GITHUB_PRIVATE_KEY_FILE=./shuriken.private-key.pem
# SHURIKEN_GITHUB_PRIVATE_KEY=

# The App's login without "@". "@shuriken-bot[bot]" is matched too.
SHURIKEN_BOT_HANDLE=shuriken-bot
SHURIKEN_REVIEW_LABEL=needs-review

# ---- Anthropic (required unless SHURIKEN_DRY_RUN=1) ----
ANTHROPIC_API_KEY=
SHURIKEN_ANTHROPIC_MODEL=claude-opus-5-5
SHURIKEN_EFFORT=high
SHURIKEN_MAX_OUTPUT_TOKENS=8000
SHURIKEN_MAX_TOOL_CALLS=8

# ---- Review tuning ----
SHURIKEN_MAX_DIFF_BYTES=200000
SHURIKEN_MAX_INLINE_COMMENTS=10
SHURIKEN_MIN_CONFIDENCE=0.6
SHURIKEN_MIN_SEVERITY=low
# Comma-separated globs. Unset uses the built-in noise list.
# SHURIKEN_EXCLUDE_GLOBS=**/*.generated.go,**/testdata/**

# ---- Cost logging (USD per million tokens) ----
# Defaults match Claude Opus 5.5. Update if you change the model.
SHURIKEN_PRICE_INPUT_PER_MTOK=4.00
SHURIKEN_PRICE_OUTPUT_PER_MTOK=20.00
SHURIKEN_PRICE_CACHE_READ_PER_MTOK=0.20
SHURIKEN_PRICE_CACHE_WRITE_PER_MTOK=5.00

# ---- Storage (required unless SHURIKEN_DRY_RUN=1) ----
# SHURIKEN'S OWN DATABASE. Do not point this at a consumer's database:
# Shuriken holds no credential for anyone else's data.
# Use the scoped "shuriken" user created by migrations/003, not an admin user.
SHURIKEN_MONGODB_URI=mongodb://localhost:27017/shuriken
SHURIKEN_MONGODB_DATABASE=shuriken
SHURIKEN_DELIVERY_TTL_DAYS=30
# Local development only. In any shared environment use migrations/002.
SHURIKEN_ENSURE_INDEXES=0

# ---- Outbound delivery ----
# Where recorded events are pushed. Unset disables publishing entirely, which
# is valid for a deployment nobody consumes yet; events still accumulate in
# the outbox and /healthz reports the depth.
# The secret must match the consumer's, e.g. openssl rand -hex 32.
# SHURIKEN_CONSUMER_WEBHOOK_URL=https://platform.example/api/shuriken/events
# SHURIKEN_CONSUMER_WEBHOOK_SECRET=
SHURIKEN_PUBLISH_INTERVAL=10s
SHURIKEN_PUBLISH_BATCH=50
SHURIKEN_PUBLISH_MAX_ATTEMPTS=8
SHURIKEN_PUBLISH_TIMEOUT=15s

# ---- Runtime ----
SHURIKEN_WORKERS=4
SHURIKEN_QUEUE_SIZE=256
SHURIKEN_JOB_TIMEOUT=5m
SHURIKEN_SHUTDOWN_TIMEOUT=20s

# ---- Dry run ----
# 1 = process events and log what would be recorded and posted, writing to
# neither the database nor GitHub.
SHURIKEN_DRY_RUN=1
